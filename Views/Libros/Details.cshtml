@model Libro
@{ ViewData["Title"] = "Detalle del libro"; }

<h1>Detalle del libro</h1>
<dl class="row">
    <dt class="col-sm-2">Título</dt><dd class="col-sm-10">@Model.Titulo</dd>
    <dt class="col-sm-2">Autor</dt><dd class="col-sm-10">@Model.AutorNombre</dd>
    <dt class="col-sm-2">Ejemplares</dt><dd class="col-sm-10">@Model.Ejemplares</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.LibroId" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>