@model IEnumerable<Libro>
@{ ViewData["Title"] = "Libros"; }

<h1>Libros</h1>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="buscar" value="@ViewData["Buscar"]" class="form-control" placeholder="Buscar por título" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
    </div>
</form>

<a asp-action="Create" class="btn btn-success mb-3">Nuevo libro</a>

<table class="table table-striped">
    <thead>
        <tr><th>Título</th><th>Autor</th><th>Ejemplares</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var libro in Model)
        {
            <partial name="_LibroFila" model="libro" />
        }
    </tbody>
</table>