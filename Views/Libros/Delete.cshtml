@model Libro
@{ ViewData["Title"] = "Eliminar libro"; }

<h1>Eliminar libro</h1>
<h4 class="text-danger">¿Seguro que deseas eliminar este libro?</h4>
<dl class="row">
    <dt class="col-sm-2">Título</dt><dd class="col-sm-10">@Model.Titulo</dd>
    <dt class="col-sm-2">Autor</dt><dd class="col-sm-10">@Model.AutorNombre</dd>
    <dt class="col-sm-2">Ejemplares</dt><dd class="col-sm-10">@Model.Ejemplares</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.LibroId" method="post">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>