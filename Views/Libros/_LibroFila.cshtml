@model Libro
<tr>
    <td>@Model.Titulo</td>
    <td>@Model.AutorNombre</td>
    <td>@Model.Ejemplares</td>
    <td>
        <a asp-action="Details" asp-route-id="@Model.LibroId" class="btn btn-sm btn-info">Detalle</a>
        <a asp-action="Edit" asp-route-id="@Model.LibroId" class="btn btn-sm btn-warning">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.LibroId" class="btn btn-sm btn-danger">Eliminar</a>
    </td>
</tr>